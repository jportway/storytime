# Copy to .env and fill in. Never commit .env.

# Required — the story engine, archivist and owl coach all use this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — the owl falls back to the browser's built-in speech synthesis
# if these are absent, so the game is fully playable without an ElevenLabs
# account. The voice is just noticeably worse.
ELEVENLABS_API_KEY=
# A warm, friendly voice. Browse voices at elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

PORT=8787

# Safety net: refuse to spend more than this many Anthropic tokens per day.
# A normal hour-long session is ~40k. Set to 0 to disable the cap.
DAILY_TOKEN_BUDGET=2000000

# ---------------------------------------------------------------------------
# Deployment only — leave all of these unset for local development.
# ---------------------------------------------------------------------------

# A GCS bucket name. Set it and stories, the writing profile, the token
# ledger, the starting template and cached audio all move there instead of
# living under data/. Unset means the local filesystem, exactly as before.
STORAGE_BUCKET=

# Opens the game. Required whenever STORAGE_BUCKET is set — the server
# refuses to start otherwise, because an internet-facing URL with a metered
# API key behind it is an open bill.
APP_PASSWORD=

# Opens /admin. Deliberately a *different* password: Cooper has the game
# password by definition, and the bible editor should not be one URL away.
ADMIN_PASSWORD=

# Optional extra salt for session cookies. Not needed — cookies are already
# signed with a key derived from the password, so changing a password signs
# everyone out on its own.
SESSION_SECRET=
